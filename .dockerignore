# Nothing listed here is needed to produce dist/.
# Note: tests/ is excluded, so `npm run build` (tsc && vite build) type-checks
# src/ and the config files only. tsconfig.json still lists "tests" in include,
# which is harmless when the directory is absent.

.git
.gitattributes
.gitignore
.dockerignore
.env
.env.*
docker-compose*.yml*
*.bak*
.DS_Store
*.sw?
node_modules
dist
dist-ssr
public/pyodide/
tests
docs
*.md
.github
.vscode
.idea
*.log
*.local

# Playwright
playwright.config.ts
playwright.screenshots.config.ts
test-results
playwright-report
blob-report
playwright/.cache

